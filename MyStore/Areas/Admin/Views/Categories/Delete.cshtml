@model MyStore.Models.Category
@{
    ViewBag.Title = "Xóa danh mục";
}

<h3 class="page-title">Xóa danh mục</h3>
<h4 class="text-danger">Bạn có chắc chắn muốn xóa danh mục này?</h4>

@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<dl class="dl-horizontal">
    <dt>Mã danh mục</dt>
    <dd>@Html.DisplayFor(model => model.CategoryID)</dd>
    <dt>Tên danh mục</dt>
    <dd>@Html.DisplayFor(model => model.CategoryName)</dd>
</dl>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <input type="submit" value="Xóa" class="btn btn-danger" />
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default" })
}
