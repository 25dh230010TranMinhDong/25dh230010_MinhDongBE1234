@model IEnumerable<MyStore.Models.Category>
@{
    ViewBag.Title = "Danh mục sản phẩm";
}

<h3 class="page-title">Quản lý danh mục sản phẩm</h3>

<p>
    @Html.ActionLink("Thêm danh mục", "Create", null, new { @class = "btn btn-success" })
</p>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Mã danh mục</th>
            <th>Tên danh mục</th>
            <th style="width:230px"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.CategoryID)</td>
                <td>@Html.DisplayFor(modelItem => item.CategoryName)</td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", new { id = item.CategoryID }, new { @class = "btn btn-primary btn-sm" })
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.CategoryID }, new { @class = "btn btn-info btn-sm" })
                    @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>
