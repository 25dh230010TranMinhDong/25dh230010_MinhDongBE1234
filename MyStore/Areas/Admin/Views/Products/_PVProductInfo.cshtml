@model MyStore.Models.Product

<div class="row">
    <div class="col-md-3">
        <img src="@Url.Content(Model.ProductImage ?? "~/Content/images/default_img.png")" class="img-responsive img-thumbnail" alt="@Model.ProductName" />
    </div>
    <div class="col-md-9">
        <dl class="dl-horizontal">
            <dt>Mã sản phẩm</dt>
            <dd>@Html.DisplayFor(model => model.ProductID)</dd>
            <dt>Danh mục</dt>
            <dd>@Html.DisplayFor(model => model.Category.CategoryName)</dd>
            <dt>Tên sản phẩm</dt>
            <dd>@Html.DisplayFor(model => model.ProductName)</dd>
            <dt>Mô tả</dt>
            <dd>@Html.DisplayFor(model => model.ProductDescription)</dd>
            <dt>Giá</dt>
            <dd>@Model.ProductPrice.ToString("N0")</dd>
        </dl>
    </div>
</div>
